    <ImageView
        android:id="@+id/color_pick"
        android:layout_width="70dp"
        android:layout_height="70dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/icon_pick_color_white"
        android:paddingTop="20dp"
        android:paddingBottom="15dp"
        android:paddingStart="16dp"
        android:paddingEnd="15dp"
        android:layout_margin="5dp"/>

    <ImageView
        android:id="@+id/selected_color"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toBottomOf="@id/color_pick"
        app:layout_constraintStart_toStartOf="@id/color_pick"
        app:layout_constraintEnd_toEndOf="@id/color_pick"
        android:layout_marginStart="5dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:src="@drawable/texture_small_brick_red"
        android:scaleType="centerCrop"/>

    <TextView
        android:id="@+id/selected_color_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/selected_color"
        app:layout_constraintStart_toStartOf="@id/selected_color"
        app:layout_constraintEnd_toEndOf="@id/selected_color"
        android:text="Selected Color:"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginTop="50dp"
        android:gravity="center"
        android:rotation="270"/>

