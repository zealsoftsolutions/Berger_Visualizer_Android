                app:cardCornerRadius="35dp"
                app:layout_constraintTop_toBottomOf="@id/product_card"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_app_views"
                    android:padding="10dp">

            <TextView
                android:id="@+id/colors_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Colors:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:visibility="gone"/>

            <HorizontalScrollView
                android:id="@+id/colors_display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/colors_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/colors_recycler"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:orientation="horizontal"
                    android:layout_gravity="center"/>

            </HorizontalScrollView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <View
                android:id="@+id/left_color_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/product_detail_color_divider_color"
                app:layout_constraintStart_toEndOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toStartOf="@id/color_name"
                app:layout_constraintTop_toTopOf="@id/color_name"
                app:layout_constraintBottom_toBottomOf="@id/color_name"
                android:layout_margin="5dp"
                android:visibility="gone"/>

            <View
                android:id="@+id/right_color_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/product_detail_color_divider_color"
                app:layout_constraintStart_toEndOf="@id/color_name"
                app:layout_constraintEnd_toStartOf="@id/end_margin_guideline"
                app:layout_constraintTop_toTopOf="@id/color_name"
                app:layout_constraintBottom_toBottomOf="@id/color_name"
                android:layout_margin="5dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/color_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/colors_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="15dp"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/secondary_recycler"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/color_name"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"
                android:layout_marginTop="10dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/sizes_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/product_card"
                android:text="@string/product_label_heading_sizes"
                android:textSize="@dimen/product_details_heading_text_size"
                android:textColor="@color/product_details_heading_text_color"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/product_details_heading_top_margin"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"/>

            <View
                android:id="@+id/sizes_left_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toStartOf="@id/sizes_label"
                app:layout_constraintTop_toTopOf="@id/sizes_label"
                app:layout_constraintBottom_toBottomOf="@id/sizes_label"
                android:background="@color/grey"
                android:layout_marginEnd="10dp"/>

            <View
                android:id="@+id/sizes_right_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintStart_toEndOf="@id/sizes_label"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"
                app:layout_constraintTop_toTopOf="@id/sizes_label"
                app:layout_constraintBottom_toBottomOf="@id/sizes_label"
                android:background="@color/grey"
                android:layout_marginStart="10dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sizes_recycler"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/sizes_label"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/surfaces_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/sizes_recycler"
                android:text="@string/product_label_heading_surfaces"
                android:textSize="@dimen/product_details_heading_text_size"
                android:textColor="@color/product_details_heading_text_color"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/product_details_heading_top_margin"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"/>

            <View
                android:id="@+id/surfaces_left_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toStartOf="@id/surfaces_label"
                app:layout_constraintTop_toTopOf="@id/surfaces_label"
                app:layout_constraintBottom_toBottomOf="@id/surfaces_label"
                android:background="@color/grey"
                android:layout_marginEnd="10dp"/>

            <View
                android:id="@+id/surfaces_right_divider"
                android:layout_width="0dp"
