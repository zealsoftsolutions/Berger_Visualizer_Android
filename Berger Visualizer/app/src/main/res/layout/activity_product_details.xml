                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/surfaces_label"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/description_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/surfaces_recycler"
                android:text="@string/product_label_heading_description"
                android:textSize="@dimen/product_details_heading_text_size"
                android:textColor="@color/product_details_heading_text_color"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/product_details_heading_top_margin"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"/>

            <View
                android:id="@+id/description_left_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toStartOf="@id/description_label"
                app:layout_constraintTop_toTopOf="@id/description_label"
                app:layout_constraintBottom_toBottomOf="@id/description_label"
                android:background="@color/grey"
                android:layout_marginEnd="10dp"/>

            <View
                android:id="@+id/description_right_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintStart_toEndOf="@id/description_label"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"
                app:layout_constraintTop_toTopOf="@id/description_label"
                app:layout_constraintBottom_toBottomOf="@id/description_label"
                android:background="@color/grey"
                android:layout_marginStart="10dp"/>

            <TextView
                android:id="@+id/description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/description_label"
                android:textSize="@dimen/product_details_text_size"
                android:textColor="@color/product_details_text_color"
                android:layout_marginTop="@dimen/product_details_text_top_margin"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"/>

            <TextView
                android:id="@+id/uses_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/description"
                android:text="@string/product_label_heading_uses"
                android:textSize="@dimen/product_details_heading_text_size"
                android:textColor="@color/product_details_heading_text_color"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/product_details_heading_top_margin"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"/>

            <View
                android:id="@+id/uses_left_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toStartOf="@id/uses_label"
                app:layout_constraintTop_toTopOf="@id/uses_label"
                app:layout_constraintBottom_toBottomOf="@id/uses_label"
                android:background="@color/grey"
                android:layout_marginEnd="10dp"/>

            <View
                android:id="@+id/uses_right_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintStart_toEndOf="@id/uses_label"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"
                app:layout_constraintTop_toTopOf="@id/uses_label"
                app:layout_constraintBottom_toBottomOf="@id/uses_label"
                android:background="@color/grey"
                android:layout_marginStart="10dp"/>

            <TextView
                android:id="@+id/uses"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/uses_label"
                android:textSize="@dimen/product_details_text_size"
                android:textColor="@color/product_details_text_color"
                android:layout_marginTop="@dimen/product_details_text_top_margin"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"/>

            <TextView
                android:id="@+id/surface_preparation_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/uses"
                android:text="@string/product_label_heading_preparation"
                android:textSize="@dimen/product_details_heading_text_size"
                android:textColor="@color/product_details_heading_text_color"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/product_details_heading_top_margin"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"/>

            <View
                android:id="@+id/surface_preparation_left_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toStartOf="@id/surface_preparation_label"
                app:layout_constraintTop_toTopOf="@id/surface_preparation_label"
                app:layout_constraintBottom_toBottomOf="@id/surface_preparation_label"
                android:background="@color/grey"
                android:layout_marginEnd="10dp"/>

            <View
                android:id="@+id/surface_preparation_right_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintStart_toEndOf="@id/surface_preparation_label"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"
                app:layout_constraintTop_toTopOf="@id/surface_preparation_label"
                app:layout_constraintBottom_toBottomOf="@id/surface_preparation_label"
                android:background="@color/grey"
                android:layout_marginStart="10dp"/>


            <TextView
                android:id="@+id/surface_preparation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/surface_preparation_label"
                android:textSize="@dimen/product_details_text_size"
                android:textColor="@color/product_details_text_color"
                android:layout_marginTop="@dimen/product_details_text_top_margin"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"/>

            <TextView
                android:id="@+id/application_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/surface_preparation"
                android:text="@string/product_label_heading_application"
                android:textSize="@dimen/product_details_heading_text_size"
                android:textColor="@color/product_details_heading_text_color"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/product_details_heading_top_margin"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"/>

            <View
                android:id="@+id/application_left_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toStartOf="@id/application_label"
                app:layout_constraintTop_toTopOf="@id/application_label"
                app:layout_constraintBottom_toBottomOf="@id/application_label"
                android:background="@color/grey"
                android:layout_marginEnd="10dp"/>

            <View
                android:id="@+id/application_right_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintStart_toEndOf="@id/application_label"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"
                app:layout_constraintTop_toTopOf="@id/application_label"
                app:layout_constraintBottom_toBottomOf="@id/application_label"
                android:background="@color/grey"
                android:layout_marginStart="10dp"/>

            <TextView
                android:id="@+id/application"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/application_label"
                android:textSize="@dimen/product_details_text_size"
                android:textColor="@color/product_details_text_color"
                android:layout_marginTop="@dimen/product_details_text_top_margin"
                app:layout_constraintStart_toStartOf="@id/start_margin_guideline"
                app:layout_constraintEnd_toEndOf="@id/end_margin_guideline"/>

            <TextView
                android:id="@+id/drying_time_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/application"
                android:text="@string/product_label_heading_drying_time"
                android:textSize="@dimen/product_details_heading_text_size"
                android:textColor="@color/product_details_heading_text_color"
