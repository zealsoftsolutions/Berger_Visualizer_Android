<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />

            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front.autofocus"
        android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/berger_app_logo"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyPaintApp"
        android:usesCleartextTraffic="true">
        <activity
            android:name="com.berger.bergerXpressVisualiserPk.activities.MyIdeaDetailsActivity"
            android:exported="false"/>
        <activity
            android:name="com.berger.bergerXpressVisualiserPk.activities.ViewImageActivity"
            android:exported="false"/>
        <activity android:name="com.berger.bergerXpressVisualiserPk.activities.MyIdeasActivity" />
        <activity android:name="com.berger.bergerXpressVisualiserPk.activities.ColorShadesDisplayActivity" />
        <activity android:name="com.berger.bergerXpressVisualiserPk.activities.DealerLocatorActivity" />
        <activity android:name="com.berger.bergerXpressVisualiserPk.activities.InspirationalIdeasActivity" />
        <activity android:name="com.berger.bergerXpressVisualiserPk.activities.ProductDetailsActivity" />
        <activity android:name="com.berger.bergerXpressVisualiserPk.activities.ProductsActivity" />
        <activity
            android:name="com.berger.bergerXpressVisualiserPk.activities.ColorShadesActivity"
            android:screenOrientation="sensorPortrait" />
        <activity
            android:name="com.berger.bergerXpressVisualiserPk.activities.ContactUsActivity"
            android:screenOrientation="sensorPortrait" />
        <activity
            android:name="com.berger.bergerXpressVisualiserPk.activities.AboutUsActivity"
            android:screenOrientation="sensorPortrait" />
        <activity
            android:name="com.berger.bergerXpressVisualiserPk.activities.HomeActivity"
            android:label="@string/title_activity_home"
            android:screenOrientation="sensorPortrait"
            android:theme="@style/Theme.MyPaintApp.NoActionBar" />
        <activity
            android:name="com.berger.bergerXpressVisualiserPk.activities.CalculatorActivity"
            android:screenOrientation="sensorPortrait"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name="com.berger.bergerXpressVisualiserPk.activities.SplashActivity"
            android:screenOrientation="sensorPortrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.berger.bergerXpressVisualiserPk.CameraViewActivity" />
        <activity
            android:name="com.berger.bergerXpressVisualiserPk.activities.SourceSelectActivity"
            android:screenOrientation="sensorPortrait" />
        <activity
            android:name="com.berger.bergerXpressVisualiserPk.activities.PaintActivity"
            android:hardwareAccelerated="true"
            android:screenOrientation="sensorPortrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
    </application>

</manifest>