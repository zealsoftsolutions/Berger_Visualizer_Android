<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/color_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="5dp"
        app:layout_constraintDimensionRatio="1:1"
        app:cardElevation="@dimen/elevation_home_card"
        app:cardCornerRadius="@dimen/corner_radius_card_home"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/color_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/color_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/color_label"
                android:scaleType="fitXY"/>

            <View
                android:id="@+id/label_background"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="@id/color_label"
                app:layout_constraintBottom_toBottomOf="@id/color_label"
                app:layout_constraintStart_toStartOf="@id/color_label"
                app:layout_constraintEnd_toEndOf="@id/color_label"
                android:background="@color/color_orange"
                android:alpha="0.3"/>

            <TextView
                android:id="@+id/color_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="Orange"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:paddingStart="@dimen/padding_text_start_home"
                android:paddingBottom="@dimen/padding_text_home"
                android:paddingEnd="@dimen/padding_text_end_home"
                android:paddingTop="@dimen/padding_text_home"/>

            <TextView
                android:id="@+id/color_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/color_label"
                android:paddingStart="@dimen/padding_text_start_home"
                android:paddingBottom="@dimen/padding_text_start_home"
                android:paddingEnd="@dimen/padding_text_end_home"
                android:text="Yellow is sunshine. It is a warm color, shining with optimism, enlightenment, and happiness and carrying the promise of a positive future. It instills energy and sparks creative thoughts. Its many shades can be used to effectively invoke different moods and create a pleasant atmosphere. While it works perfectly as the primary color, yellow often works best as a companion to other colors; to perk up a cooler, subdued palette, for a more natural, earthy flavor or outright flamboyance and excitement!"
                android:textColor="@color/white"
                android:background="@color/blackLight"
                android:maxLines="2"
                android:visibility="gone"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>