            <ImageView
                android:id="@+id/imageFromData"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/toolbar"
                app:layout_constraintBottom_toTopOf="@id/selected_performance_view"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="10dp"
                android:visibility="visible"/>

            <com.berger.bergerXpressVisualiserPk.customWidgets.MaskingView
                android:id="@+id/masking_canvas"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="@id/imageFromData"
                app:layout_constraintBottom_toBottomOf="@id/imageFromData"
                app:layout_constraintStart_toStartOf="@id/imageFromData"
                app:layout_constraintEnd_toEndOf="@id/imageFromData"
                android:visibility="invisible"/>

