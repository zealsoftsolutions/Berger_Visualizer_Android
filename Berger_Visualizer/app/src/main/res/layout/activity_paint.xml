                android:paddingEnd="5dp"
                app:tint="@color/black"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintVertical_chainStyle="packed"/>

            <TextView
                android:id="@+id/apply_masking_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/apply_masking"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/apply_masking"
                app:layout_constraintEnd_toEndOf="@id/apply_masking"
                android:text="@string/paint_button_apply_masking"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/paint_buttons_text_size"
                android:gravity="center"/>

            <ImageView
                android:id="@+id/clear_masking"
                android:layout_width="@dimen/paint_buttons_size"
                android:layout_height="@dimen/paint_buttons_size"
                app:layout_constraintStart_toEndOf="@id/apply_masking"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/clear_masking_label"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/icon_masking_tape_clear"
                android:paddingTop="5dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                app:tint="@color/black"/>

            <TextView
                android:id="@+id/clear_masking_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/clear_masking"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/clear_masking"
                app:layout_constraintEnd_toEndOf="@id/clear_masking"
                android:text="@string/paint_button_clear_masking"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/paint_buttons_text_size"
                android:gravity="center"/>


