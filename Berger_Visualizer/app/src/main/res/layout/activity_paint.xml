    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="@id/imageFromData"
        app:layout_constraintEnd_toEndOf="@id/imageFromData"
        app:layout_constraintStart_toStartOf="@id/imageFromData"
        android:layout_margin="20dp"
        style="@style/my_progress_bar_circle"
        android:alpha="0.8"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/loading"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="@id/imageFromData"
        app:layout_constraintEnd_toEndOf="@id/imageFromData"
        app:layout_constraintStart_toStartOf="@id/imageFromData"
        android:layout_margin="20dp"
        android:src="@drawable/berger_loading"
        android:visibility="gone"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/selected_performance_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/selected_colors_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:layout_marginBottom="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/performance_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:text="Performace Level:"
            android:textColor="@color/black"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/performance_low"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/performance_label"
            app:layout_constraintEnd_toStartOf="@id/performance_medium"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:text="Low"
            android:textColor="@color/white"
            android:background="@drawable/background_button"/>

        <TextView
            android:id="@+id/performance_medium"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/performance_low"
            app:layout_constraintEnd_toStartOf="@id/performance_high"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:text="Medium"
            android:textColor="@color/white"
            android:scaleType="centerCrop"
            android:background="@drawable/background_button_disabled"/>

        <TextView
            android:id="@+id/performance_high"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/performance_medium"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="5dp"
            android:text="High"
            android:textColor="@color/white"
            android:gravity="center"
            android:scaleType="centerCrop"
            android:background="@drawable/background_button_disabled"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/final_image"
        android:layout_width="@dimen/paint_buttons_size"
        android:layout_height="@dimen/paint_buttons_size"
        app:layout_constraintTop_toTopOf="@id/selected_colors_card"
        app:layout_constraintBottom_toTopOf="@id/final_image_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/selected_colors_card"
        android:src="@drawable/icon_painted"
        android:paddingTop="5dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:tint="@color/black"/>

    <TextView
        android:id="@+id/final_image_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/final_image"
        app:layout_constraintBottom_toBottomOf="@id/selected_colors_card"
        app:layout_constraintStart_toStartOf="@id/final_image"
        app:layout_constraintEnd_toEndOf="@id/final_image"
        android:text="@string/paint_button_original_picture"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="@dimen/paint_buttons_text_size"
        android:gravity="center"/>

    <ImageView
        android:id="@+id/rotate"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/selected_colors_card"
        app:layout_constraintBottom_toTopOf="@id/rotate_label"
        app:layout_constraintStart_toEndOf="@id/selected_colors_card"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_rotate_left"
        app:tint="@color/black"/>

    <TextView
        android:id="@+id/rotate_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/rotate"
        app:layout_constraintBottom_toBottomOf="@id/selected_colors_card"
        app:layout_constraintStart_toStartOf="@id/rotate"
        app:layout_constraintEnd_toEndOf="@id/rotate"
        android:text="@string/paint_button_rotate"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="@dimen/paint_buttons_text_size"
        android:gravity="center"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/selected_colors_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/elevation_home_card"
        app:cardCornerRadius="@dimen/corner_radius_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar_card"
        android:layout_marginBottom="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/selected_color_view"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:visibility="visible">

        <TextView
            android:id="@+id/selected_color_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/selected_color"
            android:text="Selected Color:"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/selected_color"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/selected_color_label"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="5dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:src="@drawable/texture_small_brick_red"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/shade_view_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_min="40dp"
            android:minHeight="40dp"
            app:cardElevation="@dimen/elevation_home_card"
            app:cardCornerRadius="@dimen/corner_radius_card"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/shade_label">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:id="@+id/shade"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:background="@color/color_yellow"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/shade_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="Select Color"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:padding="5dp"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:fadingEdge="horizontal"
            android:scrollHorizontally="true"
            android:singleLine="true"/>

<!--        <include-->
<!--            android:id="@+id/color"-->
<!--            android:layout_width="match_parent"-->
