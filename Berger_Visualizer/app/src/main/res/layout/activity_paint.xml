                android:paddingTop="5dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:layout_marginEnd="15dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/color_pick_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/color_pick"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/color_pick"
                app:layout_constraintEnd_toEndOf="@id/color_pick"
                android:text="Pick Color"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/paint_buttons_text_size"
                android:gravity="center"
                android:visibility="gone"/>


            <ImageView
                android:id="@+id/texture_pick"
                android:layout_width="@dimen/paint_buttons_size"
                android:layout_height="@dimen/paint_buttons_size"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/color_pick"
                app:layout_constraintEnd_toStartOf="@id/open_masking"
                android:src="@drawable/pick_texture"
                android:paddingTop="20dp"
                android:paddingBottom="15dp"
                android:paddingStart="16dp"
                android:paddingEnd="15dp"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/open_masking"
                android:layout_width="@dimen/paint_buttons_size"
                android:layout_height="@dimen/paint_buttons_size"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/open_masking_label"
                app:layout_constraintStart_toEndOf="@id/texture_pick"
                app:layout_constraintEnd_toStartOf="@id/save_image"
                android:src="@drawable/icon_masking_1"
                android:paddingTop="5dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:layout_marginEnd="10dp"
                app:tint="@color/black"/>

            <TextView
                android:id="@+id/open_masking_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/open_masking"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/open_masking"
                app:layout_constraintEnd_toEndOf="@id/open_masking"
                android:text="@string/paint_button_masking"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/paint_buttons_text_size"
                android:gravity="center"/>

            <ImageView
                android:id="@+id/save_image"
                android:layout_width="@dimen/paint_buttons_size"
                android:layout_height="@dimen/paint_buttons_size"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/open_masking_label"
                app:layout_constraintStart_toEndOf="@id/open_masking"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_save"
                android:paddingTop="5dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:layout_marginEnd="15dp"
                app:tint="@color/black"/>

            <TextView
                android:id="@+id/save_image_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/save_image"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/save_image"
                app:layout_constraintEnd_toEndOf="@id/save_image"
                android:text="@string/paint_button_save_image"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/paint_buttons_text_size"
                android:gravity="center"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
