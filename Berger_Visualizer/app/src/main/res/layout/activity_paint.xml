        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:paddingBottom="2dp"
            android:paddingEnd="20dp"
            android:paddingStart="20dp"
            android:background="@drawable/background_button"
            android:visibility="visible">

            <ImageView
                android:id="@+id/clear_paint"
                android:layout_width="@dimen/paint_buttons_size"
                android:layout_height="@dimen/paint_buttons_size"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/clear_paint_label"
                app:layout_constraintEnd_toStartOf="@id/undo"
                android:src="@drawable/icon_clear_b"
                android:paddingTop="5dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:layout_marginStart="15dp"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintVertical_chainStyle="packed"/>

            <TextView
                android:id="@+id/clear_paint_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/clear_paint"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/clear_paint"
                app:layout_constraintEnd_toEndOf="@id/clear_paint"
                android:text="@string/paint_button_erase"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/paint_buttons_text_size"
                android:gravity="center"/>


            <ImageView
                android:id="@+id/undo"
                android:layout_width="@dimen/paint_buttons_size"
                android:layout_height="@dimen/paint_buttons_size"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/undo_label"
                app:layout_constraintStart_toEndOf="@id/clear_paint"
                app:layout_constraintEnd_toStartOf="@id/original_image"
                android:src="@drawable/ic_undo"
                android:paddingTop="5dp"
